# .env.example
#
# H1.4.11.2：本檔案是依實際程式碼掃描（rg "process\.env"，排除 node_modules）產生的
# 安全範例。原始 H1.4.10／H1.4.11／H1.4.11.1 基準版本身就沒有附 .env.example（可查證：
# 這幾版的原始 ZIP 根目錄都沒有這個檔案），所以這不是本輪遺漏補回，而是首次新增。
#
# 下面全部是空值或示意 placeholder，不包含任何正式金鑰、密碼或現存環境的實際值。
# 部署時複製這份檔案為 .env，再依實際環境填入真實值；.env 本身不應該被提交進版本控制。

# ── 伺服器基本設定 ──────────────────────────────────────────
# 監聽的 port（未設定時，程式內有自己的預設值）
PORT=
# development / production 等
NODE_ENV=
# 對外公開的網址（用於組出回呼/連結時的 origin，例如 LINE LIFF 回跳網址）
PUBLIC_BASE_URL=
APP_BASE_URL=
# 反向代理／CDN 後方部署時，是否信任 X-Forwarded-* 表頭
TRUST_PROXY=
TRUST_REQUEST_HOST=
# 允許的 Host 表頭白名單（逗號分隔），防止 Host header 注入
ALLOWED_HOSTS=
# 明確指定時區（多數日期時間邏輯已用 twNow() 自行轉換為 Asia/Taipei，一般不需要設定）
TZ=

# ── 資料庫 ──────────────────────────────────────────────────
# sql.js 資料庫檔案路徑；不設定時使用專案內建預設路徑 data/pos.db
DB_PATH=
POS_DB_PATH=
# QA/測試工具用的暫存資料庫根目錄（僅測試腳本使用，正式環境不需要）
POS_DB_TEMP_ROOT=

# ── 安全性 / 簽章 ────────────────────────────────────────────
# 一般 JWT 簽章密鑰（如有使用到需要簽發/驗證 token 的功能）
JWT_SECRET=
# 內部服務間呼叫用的共用密鑰
INTERNAL_PROXY_SECRET=
# Cart Recovery（n8n webhook）用的共用密鑰，格式須符合
# utils/cartRecoveryOrchestration.js 的 validateSharedSecret()
# （crypto.randomBytes(32) 的 base64url 編碼，43 字元）
POS_RECOVERY_SHARED_SECRET=

# ── LINE 會員 ────────────────────────────────────────────────
# LINE 會員 return_url 白名單（逗號分隔的允許網域）
LINE_MEMBER_RETURN_URL_ALLOWLIST=
# 除錯開關（1/0），僅開發環境使用
LINE_MEMBER_DEBUG=

# ── Google Maps（外送地址/距離計算用，選用功能）──────────────
# 前端瀏覽器可見的 Maps API Key（有網域限制的那把）
GOOGLE_MAPS_BROWSER_KEY=
# 伺服器端 Geocoding/Distance Matrix 用的 Key（不可暴露給前端）
GOOGLE_MAPS_SERVER_KEY=

# ── GA4 Realtime（選用，行銷/分析儀表板用）────────────────────
GA4_REALTIME_ENABLED=
GA4_PROPERTY_ID=
GA4_STREAM_ID=
GA4_REALTIME_CACHE_SECONDS=
GA4_REALTIME_TIMEOUT_MS=
GA4_REALTIME_SINGLE_STORE_MODE=
# GA4 服務帳戶憑證：擇一提供即可（原始 JSON 字串，或 base64 編碼後的字串）
GA4_SERVICE_ACCOUNT_JSON=
GA4_SERVICE_ACCOUNT_JSON_BASE64=
# 若改用 Google Application Default Credentials，改設這個指向憑證檔路徑
GOOGLE_APPLICATION_CREDENTIALS=

# ── Geo Intelligence（選用，來客地理位置分析）─────────────────
GEO_ANALYTICS_ENABLED=
GEO_MAP_ENABLED=
GEO_ALERTS_ENABLED=
GEO_ALERT_MIN_VISITORS=
GEO_ALERT_LOW_CART_RATE=
GEO_ALERT_LOW_ORDER_RATE=
GEO_ALERT_UNKNOWN_RATE=
# 訪客來源 IP 判斷（反向代理後方時，指定信任哪個表頭作為真實來源 IP）
GEO_TRUSTED_IP_HEADER=
# 第三方 IP 定位服務（選用）
GEO_VISITOR_IP_ENABLED=
GEO_VISITOR_IP_PROVIDER=
GEO_VISITOR_IP_API_KEY=
GEO_VISITOR_IP_CACHE_TTL_SECONDS=
GEO_VISITOR_IP_FAILURE_CACHE_TTL_SECONDS=
# 內部快取簽章用的密鑰
GEO_CACHE_SECRET=
# 以下 GEO_BEHAVIOR_RULE_* 為地理行為規則引擎的可調參數（門檻值／信心分數），
# 全部有程式內建預設值，僅在需要微調規則時才需要覆寫，一般部署不需要設定：
GEO_BEHAVIOR_RULE_MIN_VISITORS=
GEO_BEHAVIOR_RULE_MIN_CART_VISITORS=
GEO_BEHAVIOR_RULE_MIN_CHECKOUT_VISITORS=
GEO_BEHAVIOR_RULE_MIN_PURCHASE_VISITORS=
GEO_BEHAVIOR_RULE_HIGH_VIEW_RATE=
GEO_BEHAVIOR_RULE_LOW_VIEW_RATE=
GEO_BEHAVIOR_RULE_HIGH_CART_RATE=
GEO_BEHAVIOR_RULE_LOW_CART_RATE=
GEO_BEHAVIOR_RULE_HIGH_CHECKOUT_RATE=
GEO_BEHAVIOR_RULE_LOW_CHECKOUT_RATE=
GEO_BEHAVIOR_RULE_HIGH_PURCHASE_RATE=
GEO_BEHAVIOR_RULE_LOW_PURCHASE_RATE=
GEO_BEHAVIOR_RULE_HIGH_OVERALL_RATE=
GEO_BEHAVIOR_RULE_LOW_OVERALL_RATE=
GEO_BEHAVIOR_RULE_HIGH_TRAFFIC_PCTL=
GEO_BEHAVIOR_RULE_LOW_TRAFFIC_PCTL=
GEO_BEHAVIOR_RULE_LOW_GEO_CONFIDENCE_RATE=
GEO_BEHAVIOR_RULE_CONF_SCORE_HIGH=
GEO_BEHAVIOR_RULE_CONF_SCORE_MEDIUM=
GEO_BEHAVIOR_RULE_CONF_ANCHOR_HIGH=
GEO_BEHAVIOR_RULE_CONF_ANCHOR_MEDIUM=
GEO_BEHAVIOR_RULE_CONF_ANCHOR_LOW=
GEO_BEHAVIOR_RULE_CONF_CONSISTENCY_FLOOR=
GEO_BEHAVIOR_RULE_CONF_CONSISTENCY_PENALTY=
GEO_BEHAVIOR_RULE_CONF_DEV_HIGH_RATIO=
GEO_BEHAVIOR_RULE_CONF_DEV_MEDIUM_RATIO=
GEO_BEHAVIOR_RULE_CONF_GEO_ID_RATE_HIGH=
GEO_BEHAVIOR_RULE_CONF_SAMPLE_HIGH_MULT=
GEO_BEHAVIOR_RULE_CONF_SAMPLE_MEDIUM_MULT=

# ── AI Marketing Center（選用）─────────────────────────────────
AIMC_SERVICE_URL=

# ── 其他選用旗標 ─────────────────────────────────────────────
# 後台管理模式相關旗標
ADMIN_MODE=
# 印表機/出單模式
PRINT_MODE=
# 資料遷移工具的上傳檔案大小上限（MB）
MIGRATION_UPLOAD_LIMIT_MB=
# 除錯用旗標（重複請求偵測等），僅開發環境使用
DEBUG_DUP=

# ── 僅測試腳本使用（正式部署不需要設定）───────────────────────
# scripts/smoke-*.js 用來模擬特定訪客來源 IP 的測試專用變數
TEST_VISITOR_IP=
