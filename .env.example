# ── POS SaaS Foundation R1 — 環境變數範例 ─────────────────────────────
# 複製為 .env 後依實際部署環境調整；.env 不應提交進版控。

# 伺服器埠號
PORT=5000

# JWT 簽章密鑰（正式環境務必更換為隨機字串，不要沿用程式內建的預設 fallback 值）
JWT_SECRET=replace-with-a-random-secret

# ── fix18-10-hotfix29-C2：資料備份／搬家 JSON 上傳大小上限 ──────────
# 只影響 POST /api/migration/import/preview 與 POST /api/migration/import
# 這兩條路徑，不影響全站其他 API 的 body size 限制（其餘 API 仍固定 5MB）。
#
# 規則（見 utils/migrationUploadLimit.js）：
#   - 預設 25MB（不設定此變數，或設定無效值時使用）
#   - 最低 1MB（低於 1 會被限制為 1）
#   - 最高硬性上限 100MB（設定超過 100 會被限制為 100，無法繞過）
#   - 非數字／空字串／NaN 一律回退為預設 25MB
#
# 範例：提高到 50MB
# MIGRATION_UPLOAD_LIMIT_MB=50
MIGRATION_UPLOAD_LIMIT_MB=25

# AI Marketing Center 反向代理相關（沿用既有設定，非本次修復範圍）
# AIMC_SERVICE_URL=http://localhost:4100
# INTERNAL_PROXY_SECRET=change-me-to-a-random-secret

# ── fix18-10-hotfix30-B5-R5.1-D/D1：Geo Intelligence — Visitor IP Geo Provider ──
# 預設值刻意保守（analytics 開啟，但 IP Geo 本身關閉、Provider 設為
# disabled），避免新部署在沒有確認過商用條款/隱私政策之前，就自動把訪客 IP
# 送到任何第三方服務。
#
# Geo 維度／API 本身（不涉及外部 IP 查詢）
GEO_ANALYTICS_ENABLED=true
#
# Visitor IP Geo（涉及外部 Provider／隱私，預設關閉）
GEO_VISITOR_IP_ENABLED=false
# 可選值：disabled（預設，完全不查詢任何 Provider）／ipapi（見
# utils/geoProviders/ipapi.js 檔頭的商用限制說明——免費端點只適合
# development/evaluation，正式商用請設定 GEO_VISITOR_IP_API_KEY 或改接其他
# Provider）。未知值會被安全地當作 disabled 處理。
GEO_VISITOR_IP_PROVIDER=disabled
# 只有使用需要金鑰的 Provider（例如 ipapi 的付費 Pro 端點）才需要設定；
# 正式環境請用密鑰管理服務／平台的 Secret 設定，不要把金鑰提交進版控。
GEO_VISITOR_IP_API_KEY=
# Provider 逾時（毫秒）；逾時一律 fail-open 為 unknown，不阻擋事件寫入。
GEO_VISITOR_IP_TIMEOUT_MS=2500
# Provider 查詢結果 cache TTL（秒）：成功 24 小時、失敗 15 分鐘，避免 Provider
# 故障或額度用盡時每個事件都重打一次。
GEO_VISITOR_IP_CACHE_TTL_SECONDS=86400
GEO_VISITOR_IP_FAILURE_CACHE_TTL_SECONDS=900
# Geo cache key 一律是 HMAC-SHA256(IP, GEO_CACHE_SECRET)，不是明文 IP 或單純
# SHA-256(IP)。正式環境請設定至少 32 字元的隨機值；未設定時會使用「行程啟動
# 時產生的隨機值」（不是固定內建字串），並在啟動 log 顯示警告，但每次重啟
# 都會換一把新 key（等同快取會在重啟後全部失效），不適合長期正式運作。
GEO_CACHE_SECRET=
#
# 行政區地圖（本階段尚未實作 UI，欄位保留給後續版本；見 CHANGELOG）
GEO_MAP_ENABLED=false

